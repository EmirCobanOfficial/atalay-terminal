{
  "name": "atalay-terminal-notesync",
  "version": "1.0.0",
  "private": true,
  "description": "The notes' Yjs model (and later their sync), built into Resources/web/notesync.js",
  "type": "module",
  "scripts": {
    "build": "esbuild index.js --bundle --minify --format=iife --target=es2020,safari16 --legal-comments=none --outfile=../Resources/web/notesync.js"
  },
  "dependencies": {
    "fractional-indexing": "4.0.0",
    "lib0": "0.2.120",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
